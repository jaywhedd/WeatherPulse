{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run scheduler",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/scheduler.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Run current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
